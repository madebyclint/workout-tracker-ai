DATABASE_URL=postgresql://user:password@host:5432/railway
PORT=3000

# ── MCP connector (remote, for claude.ai) ──
# Both must be set for the /mcp connector to be enabled; if either is
# missing the app logs a warning and runs everything else normally.
#
# claude.ai self-registers as an OAuth client on add (Dynamic Client
# Registration) — no client ID/secret or redirect_uri to configure by hand.
#
# Public HTTPS URL this app is deployed at (no trailing slash), used as the
# OAuth issuer/resource identifier. "http://localhost:3000" is allowed for
# local testing.
APP_URL=https://your-app.up.railway.app
# Password required on the /authorize screen before a code is issued. This
# app has no existing login system to piggyback on, so this is the one
# credential standing between the public internet and your data — pick a
# real password, not a placeholder.
OAUTH_LOGIN_PASSWORD=
