DATABASE_URL=postgresql://user:password@host:5432/railway
PORT=3000

# ── MCP connector (remote, for claude.ai) ──
# All five must be set for the /mcp connector to be enabled; if any are
# missing the app logs a warning and runs everything else normally.
#
# Public HTTPS URL this app is deployed at (no trailing slash), used as the
# OAuth issuer/resource identifier. "http://localhost:3000" is allowed for
# local testing.
APP_URL=https://your-app.up.railway.app
# Client ID/Secret you also paste into claude.ai's "Add custom connector" ->
# Advanced settings -> OAuth Client ID/Secret fields. Generate random values,
# e.g. `openssl rand -hex 32`.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Password required on the /authorize screen before a code is issued.
# Separate secret from the client id/secret above.
OAUTH_LOGIN_PASSWORD=
# Comma-separated list of redirect_uri values claude.ai is allowed to send a
# code back to. You likely won't know the exact value until you attempt to
# add the connector in claude.ai and see what it requests — update this env
# var (and redeploy) once you know it.
OAUTH_REDIRECT_URIS=
